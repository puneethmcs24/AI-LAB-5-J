  initial_board = [[1, 2, 3], [0, 4, 6], [7, 5, 8]]

  goal_board = [[1, 2, 3], [4, 5, 6], [7, 8, 0]]

  print("==========================================")
  print("SOLVING WITH ITERATIVE DEEPENING SEARCH (IDS)")
  print("==========================================")
  ids_result, limit = ids(initial_board, goal_board)
  if ids_result:
    print(f"Goal found at depth limit: {limit}")
    print_path(ids_result)

  print("\n==========================================")
  print("SOLVING WITH DEPTH-FIRST SEARCH (DFS)")
  print("==========================================")
  dfs_result = dfs(initial_board, goal_board)
  if dfs_result:
    print_path(dfs_result)
